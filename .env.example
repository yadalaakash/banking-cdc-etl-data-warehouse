# Banking Customer Transaction Data Warehouse & CDC Pipeline Configuration
# Environment: development / production
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Connection
# By default, uses local SQLite database for zero-friction local execution.
# To connect to PostgreSQL: postgresql://username:password@localhost:5432/banking_dw
DATABASE_URL=sqlite:///./banking_dw.db

# Ingestion Directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
RAW_DIR=./data/raw
BATCH_DIR=./data/cdc_batches

# Pipeline Settings
DEFAULT_BATCH_SIZE=1000
CDC_WATERMARK_STRATEGY=timestamp_and_id
SCD_MODE=scd_type_2
ENABLE_ANOMALY_DETECTION=true
