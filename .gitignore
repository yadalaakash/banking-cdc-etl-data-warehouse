# ==============================================================================
# GITIGNORE - BANKING CDC INCREMENTAL ETL & DATA WAREHOUSE
# ==============================================================================

# Environment & Credentials (NEVER COMMIT SECRETS)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python & Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Runtime Data Stores (DO NOT COMMIT RUNTIME DATABASES)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
banking_dw.db
banking_dw.db-shm
banking_dw.db-wal

# Ingestion Runtime Artifacts (Keep directory with .gitkeep, ignore runtime files)
data/uploads/*
!data/uploads/.gitkeep
data/cdc_batches/*
!data/cdc_batches/.gitkeep

# IDEs & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
